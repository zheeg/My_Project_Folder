import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import roc_curve, roc_auc_score

# 1. Compute ROC curve coordinates and Area Under Curve (AUC)
fpr, tpr, thresholds = roc_curve(y_test, y_pred_proba)
roc_auc = roc_auc_score(y_test, y_pred_proba)

# 2. Find the optimal threshold using Youden's J statistic (J = TPR - FPR)
j_scores = tpr - fpr
optimal_idx = np.argmax(j_scores)
optimal_threshold = thresholds[optimal_idx]
optimal_fpr = fpr[optimal_idx]
optimal_tpr = tpr[optimal_idx]

# 3. Plot ROC Curve
plt.figure(figsize=(8, 6))

# Plot model ROC curve
plt.plot(
    fpr, 
    tpr, 
    color='#1f77b4', 
    lw=2.5, 
    label=f'QC Model ROC (AUC = {roc_auc:.3f})'
)

# Plot diagonal reference line (Random Guess)
plt.plot(
    [0, 1], 
    [0, 1], 
    color='gray', 
    lw=1.5, 
    linestyle='--', 
    label='Random Chance (AUC = 0.50)'
)

# Highlight optimal operating threshold point
plt.scatter(
    optimal_fpr, 
    optimal_tpr, 
    color='red', 
    s=80, 
    zorder=5, 
    label=f'Optimal Cutoff (Threshold = {optimal_threshold:.2f})'
)

# Annotate optimal operating point
plt.annotate(
    f"Optimal Point\nTPR: {optimal_tpr:.2f}, FPR: {optimal_fpr:.2f}",
    xy=(optimal_fpr, optimal_tpr),
    xytext=(optimal_fpr + 0.08, optimal_tpr - 0.12),
    arrowprops=dict(facecolor='black', shrink=0.08, width=1, headwidth=6),
    fontsize=9,
    fontweight='bold',
    bbox=dict(boxstyle="round,pad=0.3", fc="yellow", alpha=0.5)
)

# Configure axes and labels
plt.xlim([-0.02, 1.02])
plt.ylim([-0.02, 1.05])
plt.xlabel('False Positive Rate (1 - Specificity / False Acceptance)', fontsize=11)
plt.ylabel('True Positive Rate (Sensitivity / QC Detection Rate)', fontsize=11)
plt.title(f'ROC Curve: QC 28-Day Strength Acceptance Model', fontsize=12, fontweight='bold', pad=12)
plt.legend(loc='lower right', fontsize=10)
plt.grid(True, linestyle=':', alpha=0.6)

plt.tight_layout()
plt.show()

# Print metrics at the optimal operating point
print(f"Area Under the Curve (AUC): {roc_auc:.4f}")
print(f"Optimal Decision Threshold: {optimal_threshold:.4f}")
print(f"At Optimal Point -> Sensitivity (TPR): {optimal_tpr:.2%}, False Alarm Rate (FPR): {optimal_fpr:.2%}")

