import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestRegressor
from sklearn.linear_model import Ridge
from sklearn.metrics import r2_score, mean_squared_error, mean_absolute_error

# Step 1: Select only independent and essential engineering parameters
# (Excluding Water and Cement since Water_Cement_Ratio represents them)
lean_features = [
    'Early_Strength',
    'Water_Cement_Ratio',
    'Superplasticizer',
    'BlastFurnaceSlag',
    'FlyAsh'
]

X_lean = qc_df[lean_features]
y = qc_df['Target_Strength_28d']

# Step 2: Train Ensemble Model to capture accurate benchmark
rf = RandomForestRegressor(n_estimators=100, max_depth=6, random_state=42)
rf.fit(X_lean, y)
rf_pred = rf.predict(X_lean)

# Step 3: Fit a clean linear formula on ensemble predictions (Distillation)
lean_reg = Ridge(alpha=1.0)
lean_reg.fit(X_lean, rf_pred)

y_formula_pred = lean_reg.predict(X_lean)

# Performance Metrics
r2 = r2_score(y, y_formula_pred)
rmse = np.sqrt(mean_squared_error(y, y_formula_pred))
mae = mean_absolute_error(y, y_formula_pred)

# Step 4: Display Clean Formula
intercept = lean_reg.intercept_
coefs = lean_reg.coef_

terms = [f"{intercept:.2f}"]
for name, coef in zip(lean_features, coefs):
    sign = "+" if coef >= 0 else "-"
    terms.append(f"{sign} ({abs(coef):.3f} * {name})")

formula_str = " ".join(terms)

print("=" * 75)
print("PRACTICAL 28-DAY STRENGTH FORMULA:")
print("=" * 75)
print(f"f_c_28 = {formula_str}\n")
print(f"R2 Score : {r2:.3f}")
print(f"RMSE     : {rmse:.2f} MPa")
print(f"MAE      : {mae:.2f} MPa")
print("=" * 75)

# Step 5: Summary Table
summary_df = pd.DataFrame({
    'Parameter': ['Intercept (Constant)'] + lean_features,
    'Coefficient': [intercept] + list(coefs)
})
print("\nExcel-Ready Coefficients:")
print(summary_df.to_string(index=False))

