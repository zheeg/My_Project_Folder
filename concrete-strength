```python
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score, roc_curve

# Step 1: Define mix proportion columns that define an identical batch/mix
mix_components = [
    'Cement',
    'BlastFurnaceSlag',
    'FlyAsh',
    'Water',
    'Superplasticizer',
    'CoarseAggregate',
    'FineAggregate'
]

# Step 2: Separate early-age data (e.g., 7-day tests) and 28-day target tests
# Note: You can change EARLY_AGE to 3 or 7 based on your site inspection protocol
EARLY_AGE = 7
TARGET_AGE = 28
TARGET_FC_28 = 30.0  # Required 28-day design strength (f'c in MPa)

df_early = df[df['Age'] == EARLY_AGE].copy()
df_target = df[df['Age'] == TARGET_AGE].copy()

# Rename strength columns to distinguish early vs 28-day
df_early = df_early.rename(columns={'CompressiveStrength': 'Early_Strength'})
df_target = df_target.rename(columns={'CompressiveStrength': 'Target_Strength_28d'})

# Average out any duplicate test batches with identical mix design
df_early_grouped = df_early.groupby(mix_components)['Early_Strength'].mean().reset_index()
df_target_grouped = df_target.groupby(mix_components)['Target_Strength_28d'].mean().reset_index()

# Step 3: Merge early strength with 28-day strength for identical mix formulations
qc_df = pd.merge(df_early_grouped, df_target_grouped, on=mix_components, how='inner')

# Step 4: Engineering Feature Engineering
qc_df['Water_Cement_Ratio'] = qc_df['Water'] / qc_df['Cement']
qc_df['Fine_Coarse_Ratio'] = qc_df['FineAggregate'] / qc_df['CoarseAggregate']

# Step 5: Define QC Acceptance Label (1 = Pass f'c >= 30 MPa at 28 days, 0 = Reject)
qc_df['QC_Pass_28d'] = (qc_df['Target_Strength_28d'] >= TARGET_FC_28).astype(int)

# Display dataset size after matching
print(f"Matched mixes tested at both {EARLY_AGE} and {TARGET_AGE} days: {len(qc_df)}")
print(f"Class distribution:\n{qc_df['QC_Pass_28d'].value_counts()}")

# Step 6: Features Selection (Early strength + mix characteristics)
feature_cols = [
    'Early_Strength',
    'Cement',
    'Water',
    'Water_Cement_Ratio',
    'Superplasticizer',
    'BlastFurnaceSlag',
    'FlyAsh',
    'Fine_Coarse_Ratio'
]

X = qc_df[feature_cols]
y = qc_df['QC_Pass_28d']

# Train/Test Split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y
)

# Step 7: Train Quality Control Classifier
model = RandomForestClassifier(n_estimators=100, max_depth=5, random_state=42)
model.fit(X_train, y_train)

# Step 8: Predictions and Evaluation
y_pred = model.predict(X_test)
y_pred_proba = model.predict_proba(X_test)[:, 1]

print("\n=== QC Acceptance Classification Report (28-day Prediction from Early Strength) ===")
print(classification_report(y_test, y_pred, target_names=[f'Reject (<{TARGET_FC_28} MPa)', f'Accept (>={TARGET_FC_28} MPa)']))

roc_score = roc_auc_score(y_test, y_pred_proba)
print(f"ROC-AUC Score: {roc_score:.4f}")

# Step 9: Visualizations (Confusion Matrix and Feature Importance)
fig, axes = plt.subplots(1, 2, figsize=(14, 5))

# Confusion Matrix
cm = confusion_matrix(y_test, y_pred)
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=axes[0],
            xticklabels=['Pred Reject', 'Pred Accept'],
            yticklabels=['Actual Reject', 'Actual Accept'])
axes[0].set_title(f"QC Acceptance Matrix (Based on Day {EARLY_AGE} Test)", fontsize=11, fontweight='bold')
axes[0].set_ylabel("True 28-day Status")
axes[0].set_xlabel("Early-Age Model Decision")

# Feature Importance
importances = pd.Series(model.feature_importances_, index=feature_cols).sort_values(ascending=True)
importances.plot(kind='barh', ax=axes[1], color='#2b5c8f', edgecolor='black')
axes[1].set_title("Feature Contribution to 28-Day Acceptance", fontsize=11, fontweight='bold')
axes[1].set_xlabel("Relative Importance")

plt.tight_layout()
plt.show()

